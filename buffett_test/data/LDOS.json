"entity": {
"name": "Leidos Holdings, Inc.",
"description": "Leidos Holdings, Inc. engages in providing services and solutions in the defense, intelligence, civil, and health markets. It operates through the following segments: Intelligence & Digital, Health, Homeland, and Defense. The Intelligence & Digital segment integrates intelligence tradecraft, full-spectrum cyber capabilities, and advanced technical solutions. The Health segment delivers services and solutions to federal and commercial customers in areas of public health, care coordination, and life and environmental sciences. The Homeland segment provides safety-critical software for the automation of air traffic both domestically and internationally. The Defense segment develops and produces advanced space, aerial, surface, and subsurface manned and unmanned defense systems. The company was founded by John Robert Beyster on February 3, 1969 and is headquartered in Reston, VA.",
"rbics_econ": "Industrials",
"rbics_sector": "Industrial Manufacturing",
"rbics_subsector": "Aerospace and Defense Manufacturing",
"rbics_indgrp": "Defense Manufacturing",
"country_of_risk": "US"
},
