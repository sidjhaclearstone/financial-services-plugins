"entity": {
"name": "FedEx Corporation",
"description": "FedEx Corp. is a holding company, which engages in the provision of transportation, e-commerce, and business services. It operates through the following segments: Federal Express, FedEx Freight, and FedEx Corporate and Other. The Federal Express segment provides transportation, delivery, and related logistics services for packages and freight worldwide. The FedEx Freight segment offers less-than-truckload (LTL) freight transportation services. The FedEx Corporate and Other segment includes corporate headquarters costs for executive officers and certain legal and finance functions, as well as certain other costs and credits not allocated to the company's transportation businesses. The company was founded by Frederick Wallace Smith on June 18, 1971, and is headquartered in Memphis, TN.",
"rbics_econ": "Industrials",
"rbics_sector": "Industrial Services",
"rbics_subsector": "Delivery and Logistics Services",
"rbics_indgrp": "Express Couriers",
"country_of_risk": "US"
