"entity": {
"name": "Commercial Metals Company",
"description": "Commercial Metals Co. engages in the manufacture, recycling, fabrication, and marketing of steel and metal products, as well as the provision of construction-related solutions and services. It operates through the following segments: North America Steel Group, Construction Solutions Group, and Europe Steel Group. The North America Steel Group segment comprises a vertically integrated network of recycling facilities, steel mills, and fabrication operations in the United States. The Construction Solutions Group segment provides construction-related solutions, including ground stabilization, foundation enhancement, and precast concrete products. The Europe Steel Group segment comprises recycling facilities, an electric arc furnace mini mill, and fabrication operations located primarily in Poland. The company was founded by Moses Feldman in 1915 and is headquartered in Irving, TX.",
"rbics_econ": "Non-Energy Materials",
"rbics_sector": "Mining and Mineral Products",
"rbics_subsector": "Metal Products",
"rbics_indgrp": "Primary Metals Products",
"country_of_risk": "US"
},
