"entity": {
"name": "Flex Ltd",
"description": "Flex Ltd. operates as a manufacturing services company. It delivers technology innovation, supply chain, and manufacturing solutions to diverse industries and end markets. The firm operates through the following segments: Integrated Technology Solutions (ITS), Regulated Manufacturing Solutions (RMS) and Cloud and Power Infrastructure (CPI). The Integrated Technology Solutions segment consists of Communications, including high speed networking, enterprise, and satellite communications systems Lifestyle, including premium products across commercial, home and personal product categories. The Regulated Manufacturing Solutions segment consists of Industrial, including mission-critical automation, energy, and industrial infrastructure, Automotive, including compute and power electronics platforms, and integrated systems, Healthcare, including regulated manufacturing for medical devices, drug delivery and equipment. The Cloud and Power Infrastructure segment consists of Cloud and Cooling, including integrated compute systems supporting power-dense digital infrastructure deployments, and advanced liquid cooling solutions supporting higher-density, power-intensive rack architectures, Power, utility and facility-level, including electrical infrastructure enabling reliable, scalable power delivery and high-density rack- and board-level power systems supporting power-intensive compute workloads. The company was founded by Joe McKenzie and Barbara-Ann McKenzie in 1969 and is headquartered in Austin, TX.",
"rbics_econ": "Technology",
"rbics_sector": "Electronic Components and Manufacturing",
"rbics_subsector": "Manufacturing Equipment and Services",
"rbics_indgrp": "Contract Electronic Manufacturing",
"country_of_risk": "US"
},
