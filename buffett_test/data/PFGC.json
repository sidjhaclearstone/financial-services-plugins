"entity": {
"name": "Performance Food Group Co",
"description": "Performance Food Group Co. engages in the marketing and distribution of food and food-related products. It operates through the following segments: Foodservice, Convenience, and Specialty. The Foodservice segment markets and distributes food and food-related products to independent restaurants, chain restaurants, and other institutional food-away-from-home locations. The Convenience segment distributes candy, snacks, beverages, cigarettes, other nicotine products, food and foodservice-related products, and other items to convenience stores across North America. The Specialty segment distributes candy, snacks, beverages, and other food items nationally to vending, office coffee service, theater, retail, and other channels. The company was founded in 1987 and is headquartered in Richmond, VA.",
"rbics_econ": "Consumer Non-Cyclicals",
"rbics_sector": "Food and Staples Retail",
"rbics_subsector": "Food and Beverage Retail",
"rbics_indgrp": "Retail Distributors",
