"entity": {
"name": "Emmvee Photovoltaic Power Limited",
"description": "Emmvee Photovoltaic Power Ltd. engages in the manufacture of solar photovoltaic modules and solar cells. It operates through the following segments: Photovoltaics Modules, EPC, and Others. The Photovoltaics Modules segment focuses on the manufacture and sale of photovoltaic modules and photovoltaic systems. The EPC segment focuses on Engineering, Procurement, and Construction (EPC) projects within the solar sector. The Others segment comprises of solar pumps, solar photovoltaic water pumping system, and the sale of power from an independent power plant. The company was founded by Manjunatha Donthi Venkatarathnaiah in 1992 and is headquartered in Bengaluru, India.",
"rbics_econ": "Industrials",
"rbics_sector": "Industrial Manufacturing",
"rbics_subsector": "Electrical Equipment and Power Systems",
"rbics_indgrp": "Power Generation and Support Products",
"country_of_risk": "IN"
},
