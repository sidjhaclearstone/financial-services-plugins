"entity": {
"name": "Comer Industries SpA",
"description": "Comer Industries SpA engages in designing and manufacturing advanced systems and mechatronic solutions for power transmission, supplied to major manufacturers of agricultural and industrial machinery. Its products include land preparation, soil storage, crop treatment, forage & hay machines, gearbox, driveshaft, powertrain, planetary and wheel drives. The company was founded by Fabio Storchi and Fabrizio Storchi in 1970 and is headquartered in Reggiolo, Italy.",
"rbics_econ": "Industrials",
"rbics_sector": "Industrial Manufacturing",
"rbics_subsector": "Machinery Manufacturing",
"rbics_indgrp": "Natural Resource and Construction Machinery Makers",
