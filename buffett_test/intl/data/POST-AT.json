"entity": {
"name": "Osterreichische Post AG",
"description": "\u00d6sterreichische Post AG engages in the provision of logistics and postal services. It operates through the following Divisions: Mail, Retail & Services; E-Commerce & Logistics; and Bank. The Mail, Retail & Services division includes the delivery of letters and document shipments, addressed and unaddressed direct mail, newspapers and online services such as e-letters and business operations such as input management, document logistics, and output management. The E-Commerce & Logistics division offers one-stop solutions for parcel and express parcel shipments along the entire value chain. The Bank division comprises financial services. The company was founded on March 3, 1999 and is headquartered in Vienna, Austria.",
"rbics_econ": "Industrials",
"rbics_sector": "Industrial Services",
"rbics_subsector": "Delivery and Logistics Services",
"rbics_indgrp": "Express Couriers",
"country_of_risk": "AT"
},
