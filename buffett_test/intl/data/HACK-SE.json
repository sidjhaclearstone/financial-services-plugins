"entity": {
"name": "Hacksaw AB",
"description": "Hacksaw AB engages in the development of the RGS (remote gaming server) platform. It operates across the whole B2B iGaming value chain, from game development to distribution. The firm's scalable and modular RGS platform, built on a modern code base, enables rapid development and distribution of games. Its developed games consist of digital slots, scratch cards, and instant win games. The company was founded on November 13, 2017 and is headquartered in Stockholm, Sweden.",
"rbics_econ": "Consumer Services",
"rbics_sector": "Hospitality Services",
"rbics_subsector": "Hospitality Services",
"rbics_indgrp": "Arts, Entertainment and Recreation Providers",
"country_of_risk": "SE"
